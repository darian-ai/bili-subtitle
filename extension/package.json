{
  "name": "bili-study-extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api:export": "cd .. && uv run python scripts/export_openapi.py",
    "api:generate": "npm run api:export && openapi --input openapi.json --output src/api --client fetch --useOptions",
    "api:check": "npm run api:generate && git diff --exit-code -- openapi.json src/api",
    "prepare": "wxt prepare",
    "dev": "wxt",
    "build": "npm run build:chrome && npm run build:edge",
    "build:chrome": "wxt build -b chrome",
    "build:edge": "wxt build -b edge",
    "lint": "eslint .",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@wxt-dev/module-react": "1.2.2",
    "mermaid": "11.12.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "wxt": "0.21.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.62.1",
    "@types/chrome": "^0.2.7",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "9.39.2",
    "jsdom": "28.1.0",
    "openapi-typescript-codegen": "0.31.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
