{
  "components": {
    "schemas": {
      "ChapterDetailRequest": {
        "additionalProperties": false,
        "properties": {
          "library": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Library",
            "type": "string"
          },
          "provider": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Provider",
            "type": "string"
          }
        },
        "required": [
          "library",
          "provider"
        ],
        "title": "ChapterDetailRequest",
        "type": "object"
      },
      "ChapterPracticeRequest": {
        "additionalProperties": false,
        "properties": {
          "library": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Library",
            "type": "string"
          },
          "provider": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Provider",
            "type": "string"
          }
        },
        "required": [
          "library",
          "provider"
        ],
        "title": "ChapterPracticeRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JobAccepted": {
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "status": {
            "const": "queued",
            "default": "queued",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "job_id"
        ],
        "title": "JobAccepted",
        "type": "object"
      },
      "JobProgressResponse": {
        "additionalProperties": false,
        "properties": {
          "percent": {
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Percent",
            "type": "integer"
          },
          "phase": {
            "title": "Phase",
            "type": "string"
          }
        },
        "required": [
          "phase",
          "percent"
        ],
        "title": "JobProgressResponse",
        "type": "object"
      },
      "JobResponse": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "progress": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobProgressResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "interrupted"
            ],
            "title": "Status",
            "type": "string"
          },
          "updated_at": {
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "kind",
          "status",
          "created_at",
          "updated_at"
        ],
        "title": "JobResponse",
        "type": "object"
      },
      "NoteRequest": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "maxLength": 100000,
            "minLength": 1,
            "title": "Body",
            "type": "string"
          },
          "library": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Library",
            "type": "string"
          },
          "note_type": {
            "default": "note",
            "enum": [
              "note",
              "question",
              "insight"
            ],
            "title": "Note Type",
            "type": "string"
          },
          "source_id": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Source Id",
            "type": "string"
          },
          "timestamp_ms": {
            "minimum": 0.0,
            "title": "Timestamp Ms",
            "type": "integer"
          }
        },
        "required": [
          "library",
          "source_id",
          "timestamp_ms",
          "body"
        ],
        "title": "NoteRequest",
        "type": "object"
      },
      "PairRequest": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "maxLength": 32,
            "minLength": 5,
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "PairRequest",
        "type": "object"
      },
      "PairResponse": {
        "additionalProperties": false,
        "properties": {
          "expires_at": {
            "title": "Expires At",
            "type": "string"
          },
          "token": {
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token",
          "expires_at"
        ],
        "title": "PairResponse",
        "type": "object"
      },
      "ReflectionRequest": {
        "additionalProperties": false,
        "properties": {
          "guide_id": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Guide Id",
            "type": "string"
          },
          "library": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Library",
            "type": "string"
          },
          "provider": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Provider",
            "type": "string"
          },
          "question_id": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Question Id",
            "type": "string"
          },
          "response": {
            "maxLength": 100000,
            "minLength": 1,
            "title": "Response",
            "type": "string"
          }
        },
        "required": [
          "library",
          "provider",
          "guide_id",
          "question_id",
          "response"
        ],
        "title": "ReflectionRequest",
        "type": "object"
      },
      "SourceRequest": {
        "additionalProperties": false,
        "properties": {
          "bvid": {
            "pattern": "^BV[A-Za-z0-9]{10}$",
            "title": "Bvid",
            "type": "string"
          },
          "cid": {
            "exclusiveMinimum": 0.0,
            "title": "Cid",
            "type": "integer"
          },
          "library": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Library",
            "type": "string"
          },
          "page": {
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Page",
            "type": "integer"
          },
          "provider": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Provider",
            "type": "string"
          },
          "regenerate": {
            "default": false,
            "title": "Regenerate",
            "type": "boolean"
          },
          "title": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "track_display_name": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Track Display Name"
          },
          "track_id": {
            "maxLength": 32,
            "pattern": "^[1-9][0-9]*$",
            "title": "Track Id",
            "type": "string"
          },
          "track_kind": {
            "anyOf": [
              {
                "enum": [
                  "human",
                  "ai"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Track Kind"
          },
          "track_language": {
            "anyOf": [
              {
                "maxLength": 64,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Track Language"
          }
        },
        "required": [
          "library",
          "provider",
          "bvid",
          "page",
          "cid",
          "title",
          "track_id"
        ],
        "title": "SourceRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VideoInspectRequest": {
        "additionalProperties": false,
        "properties": {
          "bvid": {
            "pattern": "^BV[A-Za-z0-9]{10}$",
            "title": "Bvid",
            "type": "string"
          },
          "library": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Library",
            "type": "string"
          },
          "page": {
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Page",
            "type": "integer"
          }
        },
        "required": [
          "library",
          "bvid",
          "page"
        ],
        "title": "VideoInspectRequest",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
